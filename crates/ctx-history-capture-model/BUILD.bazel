load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")
load("//tools/bazel:gates.bzl", "loc_check_inputs")

package(default_visibility = ["//visibility:public"])

loc_check_inputs(name = "loc_check_inputs")

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_HISTORY_CAPTURE_MODEL_DEPS = [
    "//crates/ctx-history-core:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_capture_model",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_HISTORY_CAPTURE_MODEL_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_capture_model",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CTX_HISTORY_CAPTURE_MODEL_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

ctx_rust_test(
    name = "ctx_retrieval_classifier_tests",
    srcs = ["tests/ctx_retrieval_classifier.rs"],
    crate_name = "ctx_retrieval_classifier",
    crate_root = "tests/ctx_retrieval_classifier.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":lib",
        "//crates/ctx-history-core:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)
