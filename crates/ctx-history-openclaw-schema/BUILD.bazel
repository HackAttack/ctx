load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

filegroup(name = "cargo_package_data", srcs = glob(["**"], exclude = ["BUILD.bazel"]))

rust_library(
    name = "lib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ctx_history_openclaw_schema",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ctx_history_openclaw_schema",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal = True, normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_flags = ['--cfg=feature="test-support"'],
)
