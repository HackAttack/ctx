load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")
load("//tools/bazel:gates.bzl", "loc_check_inputs")

package(default_visibility = ["//visibility:public"])

loc_check_inputs(name = "loc_check_inputs")

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "test_fixtures",
    srcs = glob(["src/codex/**/tests/fixtures/**"]),
)

RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)

CODEX_DEPS = [
    "//crates/ctx-history-capture-model:lib",
    "//crates/ctx-history-capture-runtime:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-jsonl:lib",
    "//crates/ctx-history-provider-runtime:lib",
    "//crates/ctx-history-source-io:lib",
]

CODEX_TEST_DEPS = [
    "//crates/ctx-history-capture-model:lib",
    "//crates/ctx-history-capture-runtime:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-jsonl:test_support_lib",
    "//crates/ctx-history-provider-runtime:test_support_lib",
    "//crates/ctx-history-source-io:test_support_lib",
]

CODEX_RUSTC_FLAGS = [
    '--check-cfg=cfg(feature, values("test-support"))',
    "--check-cfg=cfg(test)",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_provider_codex",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CODEX_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = CODEX_RUSTC_FLAGS,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = RUST_SRCS,
    crate_name = "ctx_history_provider_codex",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal = True, normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CODEX_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_flags = CODEX_RUSTC_FLAGS + [
        '--cfg=feature="test-support"',
    ],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_provider_codex",
    crate_root = "src/lib.rs",
    compile_data = [":test_fixtures"],
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CODEX_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_flags = CODEX_RUSTC_FLAGS,
)
