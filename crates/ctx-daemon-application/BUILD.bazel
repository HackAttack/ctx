load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "supervisor_discovery_environment_policy_source",
    testonly = True,
    srcs = ["src/supervisor/environment.rs"],
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-daemon-application",
}

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_DAEMON_APPLICATION_DEPS = [
    "//crates/ctx-client-observability:lib",
    "//crates/ctx-daemon-runtime:lib",
    "//crates/ctx-daemon-service:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-platform:lib",
]

CTX_DAEMON_APPLICATION_QUALIFICATION_DEPS = [
    "//crates/ctx-client-observability:lib",
    "//crates/ctx-daemon-runtime:qualification_lib",
    "//crates/ctx-daemon-service:qualification_lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-platform:lib",
]

CTX_DAEMON_APPLICATION_TEST_DEPS = [
    "//crates/ctx-client-observability:test_support_lib",
    "//crates/ctx-daemon-runtime:lib",
    "//crates/ctx-daemon-service:test_support_lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-platform:lib",
]

CTX_DAEMON_APPLICATION_RUSTC_FLAGS = [
    "--check-cfg=cfg(test)",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_daemon_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_DAEMON_APPLICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_DAEMON_APPLICATION_RUSTC_FLAGS,
)

rust_library(
    name = "qualification_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_daemon_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_DAEMON_APPLICATION_QUALIFICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_DAEMON_APPLICATION_RUSTC_FLAGS,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_daemon_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_DAEMON_APPLICATION_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_DAEMON_APPLICATION_RUSTC_FLAGS,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_daemon_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CTX_DAEMON_APPLICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_DAEMON_APPLICATION_RUSTC_FLAGS,
)
