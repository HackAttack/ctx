    name = "windows_gnu_toolchain",
    flag_values = {":windows_gnu_release": "true"},
)

py_test(
    name = "ci_entrypoint_contract",
    srcs = ["check_ci_entrypoint_contract.py"],
    args = [
        "$(rootpath //:.bazelrc)",
        "$(rootpath //:BUILD.bazel)",
        "$(rootpath //:scripts/check.sh)",
    ],
    data = [
        "//:.bazelrc",
        "//:BUILD.bazel",
        "//:scripts/check.sh",
    ],
    main = "check_ci_entrypoint_contract.py",
)

py_test(
    name = "ci_entrypoint_contract_mutation_tests",
    srcs = [
        "check_ci_entrypoint_contract.py",
        "check_ci_entrypoint_contract_test.py",
    ],
    data = [
        "//:.bazelrc",
        "//:BUILD.bazel",
        "//:scripts/check.sh",
    ],
    imports = ["."],
    main = "check_ci_entrypoint_contract_test.py",
)

